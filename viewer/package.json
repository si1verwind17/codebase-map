{
  "name": "code-map-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"require('fs').renameSync('../skills/visualizing-codebases/viewer/dist/index.html', '../skills/visualizing-codebases/viewer/dist/viewer.html')\" && vite build -c vite.audit.config.ts",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "e2e": "vitest run test/app/e2e.test.ts",
    "test:gpu": "VIZ_GPU=1 VIZ_CHROMIUM=${VIZ_CHROMIUM:-/usr/bin/chromium} vitest run --no-file-parallelism",
    "guide": "node scripts/guide.mjs",
    "shots:compare": "node scripts/shotset.mjs --compare",
    "profile": "node scripts/profile.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.6.4",
    "pixi.js": "8.22.0",
    "playwright-core": "1.63.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3"
  }
}
